FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY server.py sync_firmware.py firmware_manifest.py firmware-signing-public-key.pem /app/

RUN addgroup --system --gid 10001 sigurdos \
    && adduser --system --uid 10001 --gid 10001 sigurdos
USER 10001:10001

EXPOSE 8082
CMD ["python3", "server.py", "8082", "0.0.0.0"]
